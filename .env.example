# AceTalks — environment variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git. This file (.env.example) is safe to commit.
# All variables marked [REQUIRED] must be set before the app will run.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=               # [REQUIRED] e.g. https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=          # [REQUIRED] safe for client use
SUPABASE_SERVICE_ROLE_KEY=              # [REQUIRED SERVER ONLY] never expose to client

# ─── Clerk (Authentication) ──────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=      # [REQUIRED] safe for client use
CLERK_SECRET_KEY=                       # [REQUIRED SERVER ONLY] never expose to client

# ─── RevenueCat (Billing) ────────────────────────────────────────────────────
# Get from: https://app.revenuecat.com → Project Settings → API keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=         # [REQUIRED] iOS public SDK key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=     # [REQUIRED] Android public SDK key
EXPO_PUBLIC_REVENUECAT_WEB_KEY=         # [REQUIRED] Web billing public key
REVENUECAT_WEBHOOK_SECRET=              # [SERVER ONLY] for validating webhook events

# ─── Azure (TTS + Translation) ───────────────────────────────────────────────
# Get from: https://portal.azure.com → Cognitive Services → Keys and Endpoint
AZURE_TTS_KEY=                          # [REQUIRED SERVER ONLY]
AZURE_TTS_REGION=                       # [REQUIRED] e.g. eastus
AZURE_TRANSLATOR_KEY=                   # [PHASE 2] for real-time translation feature
AZURE_TRANSLATOR_REGION=                # [PHASE 2]

# ─── TTS API (server URL the client calls) ───────────────────────────────────
# This is the Railway Node.js server URL. Client sends { text, language } here.
EXPO_PUBLIC_TTS_API_URL=http://localhost:3000  # [REQUIRED] e.g. https://acetalks-api.railway.app

# ─── Cloudflare R2 (TTS Audio Cache) ─────────────────────────────────────────
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=                  # [PHASE 0] for TTS audio caching (server only)
CLOUDFLARE_R2_ACCESS_KEY_ID=            # [PHASE 0] server only
CLOUDFLARE_R2_SECRET_ACCESS_KEY=        # [PHASE 0] server only
CLOUDFLARE_R2_BUCKET=acetalks-tts       # [PHASE 0] server only
CLOUDFLARE_R2_PUBLIC_URL=               # [PHASE 0] public base URL e.g. https://pub-xxxx.r2.dev

# ─── PostHog (Analytics) ─────────────────────────────────────────────────────
# Get from: https://app.posthog.com → Project Settings
# IMPORTANT: Must be disabled for child profiles (age_group = 'child')
EXPO_PUBLIC_POSTHOG_KEY=                # [PHASE 0]
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Sentry (Error Tracking) ─────────────────────────────────────────────────
# Get from: https://sentry.io → Settings → Client Keys
EXPO_PUBLIC_SENTRY_DSN=                 # [PHASE 0]

# ─── App Config ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development         # development | staging | production
EXPO_PUBLIC_APP_URL=http://localhost:8081
